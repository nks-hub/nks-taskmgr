#include <windows.h>
#ifndef NKS_UPDATE_PRODUCT_VERSION
#define NKS_UPDATE_PRODUCT_VERSION L"0.1.0+0000000000000000000000000000000000000000"
#endif
#ifndef NKS_UPDATE_FILE_VERSION
#define NKS_UPDATE_FILE_VERSION 0,1,0,0
#endif
1 VERSIONINFO
FILEVERSION NKS_UPDATE_FILE_VERSION
PRODUCTVERSION NKS_UPDATE_FILE_VERSION
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "NKS Hub\0"
      VALUE "ProductName", "NKS Task Manager\0"
      VALUE "FileDescription", "NKS Task Manager Update Worker\0"
      VALUE "OriginalFilename", "nks-update-worker.exe\0"
      VALUE "FileVersion", NKS_UPDATE_PRODUCT_VERSION
      VALUE "ProductVersion", NKS_UPDATE_PRODUCT_VERSION
      VALUE "NksUpdateProtocol", "2\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
