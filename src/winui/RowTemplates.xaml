<ResourceDictionary
    x:Class="NksTaskMgr.WinUI.RowTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NksTaskMgr.WinUI">
      <Style x:Key="ColumnGripStyle" TargetType="Thumb">
        <Setter Property="Template">
          <Setter.Value><ControlTemplate TargetType="Thumb">
            <Grid Background="Transparent"><Border Width="1" Height="14" Background="#3b4851" HorizontalAlignment="Center" /></Grid>
          </ControlTemplate></Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="ServiceTemplate" x:DataType="local:ServiceRow">
        <Grid Height="56" Padding="18,0" BorderBrush="#2c363d" BorderThickness="0,0,0,1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="210" /><ColumnDefinition Width="105" /><ColumnDefinition Width="140" /><ColumnDefinition Width="65" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Spacing="4" Margin="0,0,14,0">
            <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind Name}" FontSize="10" Foreground="#95a4ad" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Border Grid.Column="1" Background="#222d34" CornerRadius="4" Padding="7,4" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind StateText, Mode=OneWay}" Foreground="{x:Bind StateBrush, Mode=OneWay}" FontSize="9" />
          </Border>
          <TextBlock Grid.Column="2" Text="{x:Bind Startup, Mode=OneWay}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
          <TextBlock Grid.Column="3" Text="{x:Bind PidText, Mode=OneWay}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,15,0" />
          <TextBlock Grid.Column="4" Text="{x:Bind Account, Mode=OneWay}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="ResourceTemplate" x:DataType="local:ResourceRow">
        <Grid Height="57" Padding="10,0" ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="50" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Grid Width="50" Height="31" VerticalAlignment="Center">
            <Path Data="{x:Bind Preview, Mode=OneWay}" Stroke="{x:Bind Color}" StrokeThickness="1.5" />
            <Path Data="{x:Bind UploadPreview, Mode=OneWay}" Stroke="#80c5c0" StrokeThickness="1.3" />
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind Description, Mode=OneWay}" FontSize="9" Foreground="#95a4ad" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind Value, Mode=OneWay}" FontSize="10" Foreground="{x:Bind Color}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="ProcessTemplate" x:DataType="local:ProcessRow">
        <local:ProcessRowGrid Height="51" BorderBrush="#2c363d" BorderThickness="0,0,0,1" ColumnSpacing="0" Padding="16,0">
          <StackPanel VerticalAlignment="Center" Margin="{x:Bind Indent, Mode=OneWay}">
            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind Note, Mode=OneWay}" FontSize="9" Foreground="#95a4ad" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{x:Bind PidText}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock Grid.Column="2" Text="{x:Bind CpuText, Mode=OneWay}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock Grid.Column="3" Text="{x:Bind WorkingText, Mode=OneWay}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock Grid.Column="4" Text="{x:Bind PrivateText, Mode=OneWay}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock Grid.Column="5" Text="{x:Bind ReadText, Mode=OneWay}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock Grid.Column="6" Text="{x:Bind WriteText, Mode=OneWay}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
        </local:ProcessRowGrid>
      </DataTemplate>
</ResourceDictionary>
