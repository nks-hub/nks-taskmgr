<ResourceDictionary
    x:Class="NksTaskMgr.WinUI.RowTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NksTaskMgr.WinUI">
      <Style x:Key="ColumnGripStyle" TargetType="Thumb">
        <Setter Property="Template">
          <Setter.Value><ControlTemplate TargetType="Thumb">
            <Grid Background="Transparent"><Border Width="1" Height="14" Background="{ThemeResource NksGripBrush}" HorizontalAlignment="Center" /></Grid>
          </ControlTemplate></Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="ServiceTemplate" x:DataType="local:ServiceRow">
        <Grid Height="44" Padding="18,0" BorderBrush="{ThemeResource NksRowDividerBrush}" BorderThickness="0,0,0,1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="210" /><ColumnDefinition Width="105" /><ColumnDefinition Width="140" /><ColumnDefinition Width="65" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Spacing="4" Margin="0,0,14,0">
            <TextBlock FontFamily="{ThemeResource ContentControlThemeFontFamily}" Text="{x:Bind Title, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock FontFamily="{ThemeResource ContentControlThemeFontFamily}" Text="{x:Bind Name}" FontSize="12" Foreground="{ThemeResource NksSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Border Grid.Column="1" Background="{ThemeResource NksServiceBadgeBrush}" CornerRadius="4" Padding="7,4" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock FontFamily="{ThemeResource ContentControlThemeFontFamily}" Text="{x:Bind StateText, Mode=OneWay}" Foreground="{x:Bind StateBrush, Mode=OneWay}" FontSize="12" />
          </Border>
          <TextBlock FontFamily="{ThemeResource ContentControlThemeFontFamily}" Grid.Column="2" Text="{x:Bind Startup, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
          <TextBlock FontFamily="{ThemeResource ContentControlThemeFontFamily}" Grid.Column="3" Text="{x:Bind PidText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,15,0" />
          <TextBlock FontFamily="{ThemeResource ContentControlThemeFontFamily}" Grid.Column="4" Text="{x:Bind Account, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="ResourceTemplate" x:DataType="local:ResourceRow">
        <Grid Height="{x:Bind PreviewRowHeight}" Padding="8,0" ColumnSpacing="10" ToolTipService.ToolTip="{x:Bind Description, Mode=OneWay}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Grid Width="64" Height="38" VerticalAlignment="Center">
            <Grid Margin="1">
              <Grid.Clip><RectangleGeometry Rect="0,0,62,36" /></Grid.Clip>
              <Path Data="{x:Bind PreviewFill, Mode=OneWay}" Fill="{x:Bind Color}" Opacity="0.13" />
              <Path Data="{x:Bind Preview, Mode=OneWay}" Stroke="{x:Bind Color}" StrokeThickness="1.3" />
              <Path Data="{x:Bind UploadPreview, Mode=OneWay}" Stroke="{ThemeResource NksTransmitBrush}" StrokeThickness="1.1" />
            </Grid>
            <Border BorderBrush="{ThemeResource NksDividerBrush}" BorderThickness="1" />
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock FontFamily="{ThemeResource ContentControlThemeFontFamily}" Text="{x:Bind Title, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock FontFamily="{ThemeResource ContentControlThemeFontFamily}" Text="{x:Bind Description, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource NksSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock FontFamily="{ThemeResource ContentControlThemeFontFamily}" Text="{x:Bind Value, Mode=OneWay}" FontSize="11" Foreground="{x:Bind Color}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="ProcessTemplate" x:DataType="local:ProcessSlot">
        <local:ProcessRowGrid Columns="{x:Bind Columns}" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind Row.TableMetricsDescription, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Row.TableMetricsDescription, Mode=OneWay}" BorderBrush="{ThemeResource NksRowDividerBrush}" BorderThickness="0,0,0,1" ColumnSpacing="0" Padding="16,0">
          <local:ProcessNameCell Slot="{x:Bind}" />
          <TextBlock FontFamily="{ThemeResource ContentControlThemeFontFamily}" Grid.Column="1" Text="{x:Bind Row.PidText, Mode=OneWay}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock FontFamily="{ThemeResource ContentControlThemeFontFamily}" Grid.Column="2" Text="{x:Bind Row.TableCpuText, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock FontFamily="{ThemeResource ContentControlThemeFontFamily}" Grid.Column="3" Text="{x:Bind Row.TableWorkingText, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock FontFamily="{ThemeResource ContentControlThemeFontFamily}" Grid.Column="4" Text="{x:Bind Row.TablePrivateText, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock FontFamily="{ThemeResource ContentControlThemeFontFamily}" Grid.Column="5" Text="{x:Bind Row.TableReadText, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock FontFamily="{ThemeResource ContentControlThemeFontFamily}" Grid.Column="6" Text="{x:Bind Row.TableWriteText, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
        </local:ProcessRowGrid>
      </DataTemplate>
</ResourceDictionary>
