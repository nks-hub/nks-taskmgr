<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.2.8</Version>
    <Product>NKS Task Manager</Product>
    <Title>NKS Task Manager</Title>
    <AssemblyTitle>NKS Task Manager</AssemblyTitle>
    <Company>NKS Hub</Company>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <SentryEnvironment Condition="'$(SentryEnvironment)' == ''">production</SentryEnvironment>
    <SentryNative>false</SentryNative>
    <SentryImplicitUsings>false</SentryImplicitUsings>
    <UseSentryCLI>false</UseSentryCLI>
    <DefineConstants Condition="'$(SentryDsn)' != ''">$(DefineConstants);NKS_SENTRY</DefineConstants>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <NativeMonitorPath Condition="'$(NativeMonitorPath)' == ''">$(MSBuildThisFileDirectory)..\..\build\msvc\Release\nks-monitor.dll</NativeMonitorPath>
    <IconWorkerPath Condition="'$(IconWorkerPath)' == ''">$(MSBuildThisFileDirectory)..\..\build\msvc\Release\nks-icon-worker.exe</IconWorkerPath>
    <DetailsWorkerPath Condition="'$(DetailsWorkerPath)' == ''">$(MSBuildThisFileDirectory)..\..\build\msvc\Release\nks-details-worker.exe</DetailsWorkerPath>
    <CollectorWorkerPath Condition="'$(CollectorWorkerPath)' == ''">$(MSBuildThisFileDirectory)..\..\build\msvc\Release\nks-collector-worker.exe</CollectorWorkerPath>
    <ActionsWorkerPath Condition="'$(ActionsWorkerPath)' == ''">$(MSBuildThisFileDirectory)..\..\build\msvc\Release\nks-actions-worker.exe</ActionsWorkerPath>
    <ServiceActionsWorkerPath Condition="'$(ServiceActionsWorkerPath)' == ''">$(MSBuildThisFileDirectory)..\..\build\msvc\Release\nks-service-actions-worker.exe</ServiceActionsWorkerPath>
    <DumpWorkerPath Condition="'$(DumpWorkerPath)' == ''">$(MSBuildThisFileDirectory)..\..\build\msvc\Release\nks-dump-worker.exe</DumpWorkerPath>
    <DumpWorkerX86Path Condition="'$(DumpWorkerX86Path)' == ''">$(MSBuildThisFileDirectory)..\..\build\msvc-dump-x86\Release\nks-dump-worker-x86.exe</DumpWorkerX86Path>
    <ElevationBrokerPath Condition="'$(ElevationBrokerPath)' == ''">$(MSBuildThisFileDirectory)..\..\build\msvc\Release\nks-elevation-broker.exe</ElevationBrokerPath>
    <UpdateWorkerPath Condition="'$(UpdateWorkerPath)' == ''">$(MSBuildThisFileDirectory)..\..\build\msvc\Release\nks-update-worker.exe</UpdateWorkerPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(SentryDsn)' != ''">
    <PackageReference Include="Sentry" Version="6.12.1" />
    <AssemblyMetadata Include="Nks.SentryDsn" Value="$(SentryDsn)" />
    <AssemblyMetadata Include="Nks.SentryEnvironment" Value="$(SentryEnvironment)" />
    <AssemblyMetadata Include="Nks.SentryRelease" Value="$(SentryRelease)" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="Nks.BrokerPublisherSpkiSha256" Value="$(BrokerPublisherSpkiSha256)" />
    <AssemblyMetadata Include="Nks.UpdatePublisherSpkiSha256" Value="$(UpdatePublisherSpkiSha256)" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.261008100" />
    <ProjectReference Include="..\interop\dotnet\NksTaskMgr.Native.csproj" />
    <EmbeddedResource Include="Strings\**\*.tsv" LogicalName="NksStrings.%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(NativeMonitorPath)" Link="nks-monitor.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="$(IconWorkerPath)" Link="nks-icon-worker.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="$(DetailsWorkerPath)" Link="nks-details-worker.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="$(CollectorWorkerPath)" Link="nks-collector-worker.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="$(ActionsWorkerPath)" Link="nks-actions-worker.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="$(ServiceActionsWorkerPath)" Link="nks-service-actions-worker.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="$(DumpWorkerPath)" Link="nks-dump-worker.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="$(DumpWorkerX86Path)" Link="nks-dump-worker-x86.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="$(ElevationBrokerPath)" Link="nks-elevation-broker.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="$(UpdateWorkerPath)" Link="nks-update-worker.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="..\..\assets\app.ico" Link="app.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="..\..\assets\app.png" Link="app.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
  <Target Name="RequireNativeMonitor" BeforeTargets="PrepareForBuild">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(BrokerPublisherSpkiSha256)', '^([0-9a-fA-F]{64})?$'))" Text="BrokerPublisherSpkiSha256 must be empty or 64 hexadecimal characters." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(UpdatePublisherSpkiSha256)', '^([0-9a-fA-F]{64})?$'))" Text="UpdatePublisherSpkiSha256 must be empty or 64 hexadecimal characters." />
    <Error Condition="!Exists('$(NativeMonitorPath)')" Text="Build the native Release library before publishing the WinUI candidate." />
    <Error Condition="!Exists('$(IconWorkerPath)')" Text="Build the native Release icon worker before publishing the WinUI candidate." />
    <Error Condition="!Exists('$(DetailsWorkerPath)')" Text="Build the native Release details worker before publishing the WinUI candidate." />
    <Error Condition="!Exists('$(CollectorWorkerPath)')" Text="Build the native Release collector worker before publishing the WinUI candidate." />
    <Error Condition="!Exists('$(ActionsWorkerPath)')" Text="Build the native Release actions worker before publishing the WinUI candidate." />
    <Error Condition="!Exists('$(ServiceActionsWorkerPath)')" Text="Build the native Release service actions worker before publishing the WinUI candidate." />
    <Error Condition="!Exists('$(DumpWorkerPath)')" Text="Build the native Release x64 dump worker before publishing the WinUI candidate." />
    <Error Condition="!Exists('$(DumpWorkerX86Path)')" Text="Build the native Release x86 dump worker before publishing the WinUI candidate." />
    <Error Condition="!Exists('$(ElevationBrokerPath)')" Text="Build the native Release elevation broker before publishing the WinUI candidate." />
    <Error Condition="!Exists('$(UpdateWorkerPath)')" Text="Build the native Release update worker before publishing the WinUI candidate." />
  </Target>
</Project>
