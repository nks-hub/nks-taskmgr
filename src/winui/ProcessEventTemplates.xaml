<ResourceDictionary
    x:Class="NksTaskMgr.WinUI.ProcessEventTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NksTaskMgr.WinUI">
  <DataTemplate x:Key="ProcessEvent" x:DataType="local:ProcessEventRow">
    <Grid Padding="8,5" ColumnSpacing="12" RowSpacing="3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      <TextBlock Text="{x:Bind TimeText}" FontSize="12"/>
      <TextBlock Grid.Column="1" Text="{x:Bind KindText}" FontSize="12"/>
      <TextBlock Grid.Column="2" Text="{x:Bind NameText}" FontSize="13" TextTrimming="CharacterEllipsis"/>
      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind TargetText}" FontSize="11" Foreground="{ThemeResource NksSecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
      <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Bind IdentityText}" FontSize="11" Foreground="{ThemeResource NksSecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
