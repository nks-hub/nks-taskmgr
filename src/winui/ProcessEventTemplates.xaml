<ResourceDictionary
    x:Class="NksTaskMgr.WinUI.ProcessEventTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NksTaskMgr.WinUI">
  <DataTemplate x:Key="ProcessEvent" x:DataType="local:ProcessEventRow">
    <Grid Padding="10,0" ColumnSpacing="12" MinHeight="30" ToolTipService.ToolTip="{x:Bind Tooltip}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="62"/><ColumnDefinition Width="72"/><ColumnDefinition Width="170"/><ColumnDefinition Width="56"/>
        <ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/><ColumnDefinition Width="100"/><ColumnDefinition Width="80"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="{x:Bind TimeText}" FontSize="12" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{x:Bind EventText}" FontSize="12" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="2" Text="{x:Bind NameText}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="3" Text="{x:Bind PidText}" FontSize="12" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="4" Text="{x:Bind ParentText}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="5" Text="{x:Bind CommandText}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{ThemeResource NksSecondaryTextBrush}"/>
      <TextBlock Grid.Column="6" Text="{x:Bind DurationText}" FontSize="12" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="7" Text="{x:Bind ExitText}" FontSize="12" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="8" Text="{x:Bind RepeatText}" FontSize="12" VerticalAlignment="Center"/>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
