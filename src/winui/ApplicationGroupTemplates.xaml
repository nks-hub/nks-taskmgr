<ResourceDictionary
    x:Class="NksTaskMgr.WinUI.ApplicationGroupTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NksTaskMgr.WinUI">
  <DataTemplate x:Key="ApplicationGroup" x:DataType="local:ApplicationGroupRow">
    <Grid Height="48" Padding="8,4" ColumnSpacing="8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="20" /><RowDefinition Height="20" /></Grid.RowDefinitions>
      <Viewbox Grid.RowSpan="2" Width="20" Height="20" VerticalAlignment="Center">
        <local:ProcessIconView Row="{x:Bind IconRow, Mode=OneWay}" Width="18" Height="18" />
      </Viewbox>
      <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind TitleTooltip, Mode=OneWay}"
                 FontSize="12" FontWeight="SemiBold" FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                 VerticalAlignment="Center" TextWrapping="NoWrap" MaxLines="1" TextTrimming="CharacterEllipsis" />
      <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="{x:Bind CountText, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind CpuTooltip, Mode=OneWay}"
                   FontSize="10" VerticalAlignment="Center" FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                   Foreground="{ThemeResource NksSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{x:Bind CpuText, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind CpuTooltip, Mode=OneWay}"
                   FontSize="11" VerticalAlignment="Center" FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                   TextAlignment="Right" Foreground="{ThemeResource NksSecondaryTextBrush}" />
      </Grid>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
